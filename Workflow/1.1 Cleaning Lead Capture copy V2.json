    {
      "parameters": {
        "sendTo": "tirthomoj@gmail.com",
        "subject": "=New Lead: {{ $('Classify Lead — Score + Tier').item.json.name }} — {{ $('Classify Lead — Score + Tier').item.json.lead_tier }} Priority",
        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;\">\n\n  <h2 style=\"background:#1a73e8;color:white;padding:15px;border-radius:8px;\">\n    🧹 New Lead: {{ $('Classify Lead — Score + Tier').item.json.name }} — {{ $('Classify Lead — Score + Tier').item.json.lead_tier }} Priority\n  </h2>\n\n  <h3 style=\"color:#1a73e8;\">👤 Customer Details</h3>\n  <table style=\"width:100%;border-collapse:collapse;\">\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Name</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.name }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Email</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.email }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Phone</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.phone }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>ZIP Code</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.zip_code }}</td></tr>\n  </table>\n\n  <h3 style=\"color:#1a73e8;\">🏠 Service Details</h3>\n  <table style=\"width:100%;border-collapse:collapse;\">\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Service Type</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.service_type }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Bedrooms</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.bedrooms }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Bathrooms</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.bathrooms }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Frequency</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.frequency }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Preferred Date</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.preferred_date }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Special Instructions</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.special_instructions || 'None' }}</td></tr>\n  </table>\n\n  <h3 style=\"color:#1a73e8;\">🏆 Lead Classification</h3>\n  <table style=\"width:100%;border-collapse:collapse;\">\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Lead Tier</b></td><td style=\"padding:8px;border:1px solid #ddd;\"><b style=\"color:#e53935;\">{{ $('Classify Lead — Score + Tier').item.json.lead_tier }}</b></td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Lead Score</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.lead_score }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Next Action</b></td><td style=\"padding:8px;border:1px solid #ddd;\"><b>{{ $('Classify Lead — Score + Tier').item.json.next_action }}</b></td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Note</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Classify Lead — Score + Tier').item.json.follow_up_note }}</td></tr>\n  </table>\n\n  <h3 style=\"color:#1a73e8;\">🤖 AI Review</h3>\n  <table style=\"width:100%;border-collapse:collapse;\">\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Has Pets</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Extract AI Signals — Pets + Allergies').item.json.ai_extraction ? JSON.parse($('Extract AI Signals — Pets + Allergies').item.json.ai_extraction).has_pets : 'N/A' }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Has Allergies</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Extract AI Signals — Pets + Allergies').item.json.ai_extraction ? JSON.parse($('Extract AI Signals — Pets + Allergies').item.json.ai_extraction).has_allergies : 'N/A' }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Urgency</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Extract AI Signals — Pets + Allergies').item.json.urgency_signal || 'NORMAL' }}</td></tr>\n    <tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Human Review Needed</b></td><td style=\"padding:8px;border:1px solid #ddd;\">{{ $('Extract AI Signals — Pets + Allergies').item.json.human_review_required }}</td></tr>\n  </table>\n\n  <p style=\"color:#666;font-size:12px;margin-top:20px;\">\n    Submitted: {{ $('Classify Lead — Score + Tier').item.json.submission_timestamp }}\n  </p>\n\n</div>",

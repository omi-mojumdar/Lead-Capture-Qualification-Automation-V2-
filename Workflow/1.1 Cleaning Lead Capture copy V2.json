    {
      "parameters": {
        "jsCode": "const data = $input.first().json?.body || $input.first().json;\n\n// Detect Tally vs flat JSON (Lovable)\nconst tallyFields = data?.body?.data?.fields || \n                    data?.body?.fields || \n                    data?.fields || \n                    null;\n\nlet name, email, phone, zip_code, service_type,\n    bedrooms, bathrooms, frequency, preferred_date,\n    special_instructions, consent_status,\n    lead_source, submission_timestamp;\n\nif (tallyFields && Array.isArray(tallyFields) && tallyFields.length > 0) {\n  // ── TALLY FORMAT ──────────────────────────────\n  const get = (label) => {\n    const field = tallyFields.find(f => f.label === label);\n    if (!field) return \"\";\n    if (field.options && field.value) {\n      const ids = Array.isArray(field.value) ? field.value : [field.value];\n      const matched = field.options.filter(o => ids.includes(o.id));\n      return matched.map(o => o.text).join(\", \");\n    }\n    return field.value || \"\";\n  };\n\n  name                 = get(\"Full Name\").trim();\n  email                = get(\"Email Address\").toLowerCase().trim();\n  phone                = get(\"Phone Number\").trim();\n  zip_code             = get(\"ZIP Code\").trim();\n  service_type         = get(\"Service Type\");\n  bedrooms             = get(\"Number of Bedrooms\");\n  bathrooms            = get(\"Number of Bathrooms\");\n  frequency            = get(\"Cleaning Frequency\");\n  preferred_date       = get(\"Preferred Date\");\n  special_instructions = get(\"Special Instructions\");\n  consent_status       = get(\"I consent to being contacted about my cleaning enquiry\") || \"Not Provided\";\n  lead_source          = \"Tally Form\";\n  submission_timestamp = data?.body?.createdAt || new Date().toISOString();\n\n} else {\n  // ── LOVABLE FLAT JSON FORMAT ───────────────────\n  name                 = (data.name || \"\").trim();\n  email                = (data.email || \"\").toLowerCase().trim();\n  phone                = (data.phone || \"\").trim();\n  zip_code             = (data.zip_code || \"\").trim();\n  service_type         = data.service_type || \"\";\n  bedrooms             = data.bedrooms || \"\";\n  bathrooms            = data.bathrooms || \"\";\n  frequency            = data.frequency || \"\";\n  preferred_date       = data.preferred_date || \"\";\n  special_instructions = data.special_instructions || \"\";\n  consent_status       = data.consent_status || \"Not Provided\";\n  lead_source          = data.lead_source || \"Website Form\";\n  submission_timestamp = data.submission_timestamp || new Date().toISOString();\n}\n\nreturn [{\n  json: {\n    name,\n    email,\n    phone,\n    zip_code,\n    service_type,\n    bedrooms,\n    bathrooms,\n    frequency,\n    preferred_date,\n    special_instructions,\n    consent_status,\n    lead_source,\n    submission_timestamp,\n    status: \"NEW\"\n  }\n}];"
      },

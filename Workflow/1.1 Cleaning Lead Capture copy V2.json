        "jsCode": "const lead = $input.first().json;\n\n// Supported ZIP codes (Austin, Texas area)\nconst supportedZips = [\n  \"78701\", \"78702\", \"78703\", \"78704\", \"78705\",\n  \"78731\", \"78732\", \"78733\", \"78741\", \"78745\"\n];\n\nconst inServiceArea = supportedZips.includes(lead.zip_code);\n\nreturn [{\n  json: {\n    ...lead,\n    serviceArea: inServiceArea ? \"SUPPORTED\" : \"UNSUPPORTED\",\n    status: inServiceArea ? \"VALID\" : \"OUT_OF_AREA\"\n  }\n}];"

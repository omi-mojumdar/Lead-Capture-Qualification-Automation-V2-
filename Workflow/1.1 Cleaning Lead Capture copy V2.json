    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nconst missing = [];\n\nif (!lead.name) missing.push(\"Name\");\nif (!lead.email || !lead.email.includes(\"@\")) missing.push(\"Email\");\nif (!lead.phone) missing.push(\"Phone\");\nif (!lead.zip_code || lead.zip_code.length < 5) missing.push(\"ZIP Code\");\nif (!lead.service_type) missing.push(\"Service Type\");\nif (!lead.bedrooms) missing.push(\"Bedrooms\");\nif (!lead.bathrooms) missing.push(\"Bathrooms\");\nif (!lead.frequency) missing.push(\"Frequency\");\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      ...lead,\n      status: \"INVALID\",\n      reason: \"Missing fields: \" + missing.join(\", \")\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...lead,\n    status: \"VALID\"\n  }\n}];"
      },

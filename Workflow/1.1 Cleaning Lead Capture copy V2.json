    {
      "parameters": {
        "jsCode": "const original = $('Cleans messy Tally data into readable fields').item.json;\n\nconst serviceType = original.service_type || '';\nconst bedrooms = parseInt(original.bedrooms) || 0;\nconst bathrooms = parseInt(original.bathrooms) || 0;\nconst frequency = original.frequency || '';\nconst specialInstructions = original.special_instructions || '';\n\nlet score = 0;\n\nif (serviceType === 'Deep Cleaning') score += 40;\nelse if (serviceType === 'Move In / Move Out') score += 35;\nelse if (serviceType === 'Post-Construction') score += 35;\nelse if (serviceType === 'Standard Cleaning') score += 20;\n\nif (bedrooms >= 4) score += 25;\nelse if (bedrooms === 3) score += 20;\nelse if (bedrooms === 2) score += 15;\nelse score += 5;\n\nif (frequency === 'Weekly') score += 30;\nelse if (frequency === 'Bi-Weekly') score += 25;\nelse if (frequency === 'Monthly') score += 15;\nelse if (frequency === 'One-Time') score += 5;\n\nif (bathrooms >= 3) score += 10;\n\nlet leadTier, nextAction, followUpNote;\n\nif (score >= 80) {\n  leadTier = 'HIGH';\n  nextAction = 'Call within 2 hours';\n  followUpNote = 'High-value lead. Prioritize personal outreach.';\n} else if (score >= 50) {\n  leadTier = 'MEDIUM';\n  nextAction = 'Send quote within 24 hours';\n  followUpNote = 'Qualified lead. Send personalized quote today.';\n} else {\n  leadTier = 'LOW';\n  nextAction = 'Send standard follow-up email';\n  followUpNote = 'Standard enquiry. Use email sequence.';\n}\n\nconst needsAiReview = specialInstructions.trim().length > 0;\n\nreturn [{\n  json: {\n    ...original,\n    lead_score: score,\n    lead_tier: leadTier,\n    next_action: nextAction,\n    follow_up_note: followUpNote,\n    needs_ai_review: needsAiReview\n  }\n}];"
      },

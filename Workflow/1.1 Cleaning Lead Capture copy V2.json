    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst text = (input.special_instructions || '').toLowerCase();\n\n// Step 1 — Keyword Extraction (replaces HTTP Request + Gemini)\nconst aiResult = {\n  has_pets: /dog|cat|pet|animal|bird/i.test(text),\n  has_allergies: /allerg|sensitive|reaction/i.test(text),\n  allergy_details: /allerg|sensitive|reaction/i.test(text) ? text : null,\n  urgency_signal: /urgent|asap|emergency|today/i.test(text) ? 'URGENT' : 'NORMAL',\n  specific_areas: /kitchen|bathroom|bedroom|living|basement|garage/i.test(text) ? text : null,\n  access_notes: /key|code|door|access|lockbox/i.test(text) ? text : null\n};\n\n// Step 2 — Validate (original Code in JavaScript1 logic)\nconst requiredKeys = ['has_pets', 'has_allergies', 'urgency_signal'];\nconst hasAllKeys = requiredKeys.every(key => aiResult.hasOwnProperty(key));\n\nif (!hasAllKeys) {\n  return [{\n    json: {\n      ...input,\n      ai_extraction: null,\n      ai_valid: false,\n      human_review_required: true,\n      human_review_reason: 'Extraction missing required fields'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...input,\n    ai_extraction: JSON.stringify(aiResult),\n    ai_valid: true,\n    human_review_required: false,\n    urgency_signal: aiResult.urgency_signal || 'NORMAL'\n  }\n}];"
      },
